    "@vp/db": "workspace:*",
    "@vp/dev-token": "workspace:*",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
