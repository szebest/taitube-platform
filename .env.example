# =============================================================================
# video-pipeline — environment contract (shared by apps/api and apps/worker)
# Copy to .env for local development. Never commit .env.
# Parsed by packages/config (zod) — boot fails fast with a list of invalid keys.
# 🔒 = secret. Cloud values are examples; replace with your own.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=development                      # development | test | production
LOG_LEVEL=debug                           # trace|debug|info|warn|error
SERVICE_VERSION=dev                       # set to git sha by Dockerfile
ADAPTER_FAMILY=external                   # external | in-memory (in-process tests only)
# read by Node itself; compose and the images set --import @vp/config/register
NODE_OPTIONS=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # comma list; production refuses empty or *
# comma list of proxy addresses or CIDRs whose X-Forwarded-For the API trusts; empty = none
TRUST_PROXY=
HTTP_BODY_LIMIT_BYTES=1048576             # JSON body cap; uploads go straight to S3
# REACT_APP_API_BASE_URL=http://localhost:3000 # apps/web build-time only, inlined by CRA; not a server key, so not in @vp/env-schema
PORT=3000
METRICS_PORT=9464
PAGE_SIZE_DEFAULT=20                      # keyset page size when a request omits ?limit
PAGE_SIZE_MAX=100                         # upper bound a request can ask for; below 100 clamps, never rejects
TURBO_TELEMETRY_DISABLED=1                # local-first: no phone-home from tooling (SDD P9)
DO_NOT_TRACK=1

# ---- PostgreSQL -------------------------------------------------------------
# local (compose)
DATABASE_URL=postgres://vp:vp@localhost:5432/vp                                     # 🔒
# empty = DATABASE_URL; set a direct (non-pooled) connection when DATABASE_URL is pooled
DATABASE_URL_MIGRATIONS=
DATABASE_POOL_MAX=10
# cloud (Neon) — use the "-pooler" host for DATABASE_URL and the direct host for migrations
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/vp?sslmode=require
# DATABASE_URL_MIGRATIONS=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/vp?sslmode=require
# DATABASE_POOL_MAX=5

# ---- Redis (BullMQ queues + Pub/Sub) ----------------------------------------
REDIS_URL=redis://localhost:6379/0                                                  # queues and cache (db 0)
REDIS_PUBSUB_URL=redis://localhost:6379/1                                           # pub/sub (db 1)
BULLMQ_PREFIX=bull
# read by the KEDA redis trigger, not the app
REDIS_ADDR=redis:6379
REDIS_PASSWORD=vp                                                                   # 🔒

# ---- Object storage (S3-compatible) ----------------------------------------
# local: MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin                                                         # 🔒
S3_SECRET_ACCESS_KEY=minioadmin                                                     # 🔒
S3_BUCKET_RAW=raw
S3_BUCKET_PUBLIC=public
S3_PRESIGN_TTL_SEC=900
CDN_BASE_URL=http://localhost:9000/public
# cloud: Cloudflare R2  (dash.cloudflare.com → R2 → Manage R2 API Tokens)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET_RAW=vp-raw
# S3_BUCKET_PUBLIC=vp-public
# CDN_BASE_URL=https://cdn.example.com          # R2 custom domain (Cloudflare-proxied)
# fallback: Backblaze B2
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=<B2_KEY_ID>
# S3_SECRET_ACCESS_KEY=<B2_APPLICATION_KEY>
S3_MULTIPART_THRESHOLD_BYTES=104857600      # 100 MB → multipart above this
S3_PART_SIZE_MIN_BYTES=8388608              # 8 MB
S3_PART_SIZE_MAX_BYTES=67108864             # 64 MB
RAW_RETENTION_DAYS=7                        # also configured as a bucket lifecycle rule

# ---- Auth -------------------------------------------------------------------
AUTH_MODE=dev                                                # dev (pnpm dev-token keys) | jwks (your IdP); production refuses dev
# jwks mode only: your IdP's key set
AUTH_JWKS_URL=
AUTH_ISSUER=vp-dev                                           # compared to the token's iss
AUTH_AUDIENCE=vp-api                                         # compared to the token's aud
AUTH_ALGORITHMS=RS256,ES256                                  # jwks mode: the algs a token may use
AUTH_DEV_USER_ID=00000000-0000-7000-8000-000000000001       # dev mode: the provisioned user ADMIN_TOKEN acts as
ADMIN_TOKEN=change-me-32-bytes-random                        # 🔒 dev mode x-admin-token for /admin and Bull Board; production refuses any value

# ---- Pipeline tuning --------------------------------------------------------
WORKER_STAGE=probe                          # probe|transcode-1080p|transcode-720p|transcode-480p|thumbnail|package|notify|housekeeping (worker only)
# empty = stage default from registry
WORKER_CONCURRENCY=
WORKER_RUNTIME=bun                          # bun | node, read by the image CMD, not the app
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=2                            # = container CPU limit (K8s: resourceFieldRef limits.cpu)
X264_PRESET=veryfast
HLS_SEGMENT_SECONDS=6
GOP_SECONDS=2
MAX_UPLOAD_BYTES=4294967296                 # 4 GB
MAX_DURATION_SEC=3600
JOB_TIMEOUT_FACTOR=3                        # transcode hard timeout = max(factor x duration, 10 min)
MAX_INFLIGHT_PER_USER=3
UPLOAD_RATE_LIMIT_MAX=30                     # POST /v1/uploads per user per minute
TMP_DIR=/tmp/vp
SSE_HEARTBEAT_MS=15000
SSE_MAX_PER_USER=20
SSE_MAX_PER_POD=5000
SPRITE_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_PATH=/tmp/vp/heartbeat          # the file the worker liveness probe reads

# ---- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Alloy's upstream, read by Alloy and never by the apps, which export to Alloy through OTEL_EXPORTER_OTLP_ENDPOINT
GRAFANA_OTLP_ENDPOINT=
# 🔒 Authorization=Basic <base64(instanceId:token)> for GRAFANA_OTLP_ENDPOINT
GRAFANA_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_always_on   # cloud: parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0                 # cloud: 0.2
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# Alloy / k6 only (not read by the apps):
# PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod-xx.grafana.net/api/prom/push   # 🔒 basic auth
# LOKI_URL=https://logs-prod-xx.grafana.net/loki/api/v1/push                          # 🔒
# SENTRY_DSN=                                                                           # 🔒 optional

# ---- Cloud-only (Phase 4) ---------------------------------------------------
# 🔒 read by cloudflared, not the app
CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_API_TOKEN=                     # 🔒 Terraform: R2 buckets, DNS, tunnel
# CLOUDFLARE_ACCOUNT_ID=
# HCLOUD_TOKEN=                             # 🔒 Terraform: Hetzner
# GHCR_USERNAME=
# GHCR_TOKEN=                               # 🔒 only for private images

# ---- Load tests (k6) --------------------------------------------------------
# API=http://localhost:3000
# TOKEN=<dev jwt from pnpm dev-token mint --raw>
# K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
