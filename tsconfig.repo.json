{
  "extends": "./packages/platform/universal/tsconfig/server.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@vp/adapters": ["./packages/server/adapters"],
      "@vp/adapters/*": ["./packages/server/adapters/*"],
      "@vp/core/*": ["./packages/server/core/*"],
      "@vp/db/*": ["./packages/server/db/src/*"],
      "@vp/domain/*": ["./packages/universal/domain/src/*"],
      "@vp/storage/*": ["./packages/server/storage/src/*"],
      "@kit/testing/*": ["./packages/platform/server/testing/src/*"],
      "@vp/testing-fixtures/*": ["./packages/server/testing-fixtures/src/*"],
      "@kit/*": [
        "./packages/platform/universal/*/src",
        "./packages/platform/server/*/src",
        "./packages/platform/client/*/src"
      ],
      "@vp/*": ["./packages/universal/*/src", "./packages/server/*/src", "./packages/client/*/src"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/load", "tests/playwright", "tests/fixtures/second-app"]
}
