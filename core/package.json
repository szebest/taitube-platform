{
  "name": "@vp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/ports/index.js",
  "types": "./dist/ports/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "exports": {
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js",
      "default": "./dist/ports/index.js"
    },
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "import": "./dist/ports/*.js",
      "default": "./dist/ports/*.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js",
      "default": "./dist/repositories/index.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "import": "./dist/repositories/*.js",
      "default": "./dist/repositories/*.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js",
      "default": "./dist/domain/index.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js",
      "default": "./dist/domain/*.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "import": "./dist/pagination/index.js",
      "default": "./dist/pagination/index.js"
    },
    "./pagination/*": {
      "types": "./dist/pagination/*.d.ts",
      "import": "./dist/pagination/*.js",
      "default": "./dist/pagination/*.js"
    }
  },
  "devDependencies": {
    "@vp/permissions": "workspace:*",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "vp": {
    "tier": "server"
  }
}
