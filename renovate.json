{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
  "timezone": "UTC",
  "schedule": ["before 4am on monday"],
  "packageRules": [
    {
      "description": "Group minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "The Oxc and Vite+ toolchain ships breaking changes in minors: exact pins, one PR each, never in the grouped bump",
      "matchPackageNames": [
        "vite-plus",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt",
        "@vitejs/plugin-react",
        "oxc-transform-react",
        "@rolldown/plugin-babel",
        "babel-plugin-react-compiler",
        "tsdown"
      ],
      "rangeStrategy": "pin",
      "groupName": null
    },
    {
      "description": "Pin GitHub Actions by digest",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  }
}
