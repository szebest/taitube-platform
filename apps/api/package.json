{
  "name": "@vp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env --import ./src/instrument.ts src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsx ../../scripts/bundle-entrypoints.ts dist/bundle src/main.ts src/instrument.ts src/migrate.ts src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@bull-board/api": "^9.8.0",
    "@bull-board/fastify": "^9.8.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@opentelemetry/api": "^1.9.1",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@vp/adapters": "workspace:*",
    "@vp/api-contracts": "workspace:*",
    "@vp/composition": "workspace:*",
    "@vp/concurrency": "workspace:*",
    "@vp/config": "workspace:*",
    "@vp/core": "workspace:*",
    "@vp/db": "workspace:*",
    "@vp/dev-token": "workspace:*",
    "@vp/domain": "workspace:*",
    "@vp/domain-rules": "workspace:*",
    "@vp/env-schema": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/events": "workspace:*",
    "@vp/job-contracts": "workspace:*",
    "@vp/logger": "workspace:*",
    "@vp/observability": "workspace:*",
    "@vp/pagination": "workspace:*",
    "@vp/permissions": "workspace:*",
    "@vp/result": "workspace:*",
    "@vp/storage": "workspace:*",
    "@vp/validation": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^24.0.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "js-yaml": "^5.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "vp": {
    "tier": "server",
    "layer": 5
  }
}
