{
  "name": "@vp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "node --import @vp/config/register dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@bull-board/api": "^9.8.0",
    "@bull-board/fastify": "^9.8.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@scalar/fastify-api-reference": "^1.67.0",
    "@vp/adapters": "workspace:*",
    "@vp/api-contracts": "workspace:*",
    "@vp/composition": "workspace:*",
    "@vp/concurrency": "workspace:*",
    "@vp/config": "workspace:*",
    "@vp/core": "workspace:*",
    "@vp/db": "workspace:*",
    "@vp/dev-token": "workspace:*",
    "@vp/domain": "workspace:*",
    "@vp/domain-rules": "workspace:*",
    "@vp/env-schema": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/events": "workspace:*",
    "@vp/job-contracts": "workspace:*",
    "@vp/observability": "workspace:*",
    "@vp/pagination": "workspace:*",
    "@vp/permissions": "workspace:*",
    "@vp/result": "workspace:*",
    "@vp/storage": "workspace:*",
    "@vp/validation": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "prom-client": "^15.1.3",
    "uuidv7": "^1.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/node": "^24.0.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "vp": {
    "tier": "server",
    "layer": 5
  }
}
