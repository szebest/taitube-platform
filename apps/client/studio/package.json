{
  "name": "@vp/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "srvx serve --prod --port 5174 --static ../client --entry dist/server/server.js",
    "test": "vitest run && vitest run --config vitest.jsdom.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@vp/api-client": "workspace:*",
    "@vp/intl-react": "workspace:*",
    "@vp/queries": "workspace:*",
    "@vp/security-headers": "workspace:*",
    "@vp/ui": "workspace:*",
    "bootstrap": "^5.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/tsconfig": "workspace:*",
    "@vp/vite-preset": "workspace:*",
    "@vp/web-testing": "workspace:*",
    "jsdom": "^30.1.2",
    "msw": "~3.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 6
  }
