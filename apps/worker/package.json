{
  "name": "@vp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @vp/config/register --import ./dist/instrument.js dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@vp/adapters": "workspace:*",
    "@vp/composition": "workspace:*",
    "@vp/config": "workspace:*",
    "@vp/core": "workspace:*",
    "@vp/domain": "workspace:*",
    "@vp/env-schema": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/events": "workspace:*",
    "@vp/ffmpeg": "workspace:*",
    "@vp/job-contracts": "workspace:*",
    "@vp/logger": "workspace:*",
    "@vp/observability": "workspace:*",
    "@vp/result": "workspace:*",
    "@vp/storage": "workspace:*",
    "@vp/validation": "workspace:*",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^24.19.1",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "tier": "server",
    "layer": 5
  }
}
