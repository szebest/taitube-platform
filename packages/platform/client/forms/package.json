{
  "name": "@kit/forms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vp test run && vp test run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kit/result": "workspace:*",
    "@kit/ui": "workspace:*",
    "@vp/errors": "workspace:*"
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@kit/vite-preset": "workspace:*",
    "@kit/web-testing": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/validation": "workspace:*",
    "file-selector": "^5.0.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.33.5",
    "file-selector": "^5.0.1",
    "react": "^19.3.0",
    "react-dropzone": "^20.1.2"
  },
  "vp": {
    "layer": 7
