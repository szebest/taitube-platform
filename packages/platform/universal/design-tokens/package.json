{
  "name": "@kit/design-tokens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "source": "./src/contract/index.ts",
      "import": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vp test run && vp test run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kit/appearance": "workspace:*",
    "@kit/errors": "workspace:*",
    "@kit/result": "workspace:*"
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  },
  "vp": {
    "layer": 5
  },
  "peerDependencies": {
    "vitest": "catalog:",
    "zod": "^4.6.5"
  }
}
