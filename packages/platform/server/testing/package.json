{
  "name": "@kit/testing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./src/result.ts",
      "default": "./dist/result.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./src/jwt.ts",
      "default": "./dist/jwt.js"
    },
    "./log-capture": {
      "types": "./dist/log-capture.d.ts",
      "import": "./src/log-capture.ts",
      "default": "./dist/log-capture.js"
    },
    "./run-entrypoint": {
      "types": "./dist/run-entrypoint.d.ts",
      "import": "./src/run-entrypoint.ts",
      "default": "./dist/run-entrypoint.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kit/result": "workspace:*"
  },
  "devDependencies": {
    "@kit/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "vp": {
    "layer": 2
  },
  "peerDependencies": {
    "tsx": "^4.23.15",
    "vite-plus": "catalog:"
  },
  "peerDependenciesMeta": {
    "tsx": {
      "optional": true
    }
  }
}
