{
  "name": "@vp/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js",
      "default": "./dist/composition/index.js"
    },
    "./s3": {
      "types": "./dist/s3/index.d.ts",
      "import": "./dist/s3/index.js",
      "default": "./dist/s3/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js",
      "default": "./dist/redis/index.js"
    },
    "./redis/*": {
      "types": "./dist/redis/*.d.ts",
      "import": "./dist/redis/*.js",
      "default": "./dist/redis/*.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq/index.d.ts",
      "import": "./dist/bullmq/index.js",
      "default": "./dist/bullmq/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./in-memory": {
      "types": "./dist/in-memory/index.d.ts",
      "import": "./dist/in-memory/index.js",
      "default": "./dist/in-memory/index.js"
    },
    "./in-memory/*": {
      "types": "./dist/in-memory/*.d.ts",
      "import": "./dist/in-memory/*.js",
      "default": "./dist/in-memory/*.js"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "import": "./dist/authorization/index.js",
      "default": "./dist/authorization/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:integration": "vp test run --config integration.config.ts",
    "test:perf": "vp test run --config perf.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@bull-board/api": "^9.10.4",
    "@casl/ability": "^7.0.1",
    "@kit/composition": "workspace:*",
    "@kit/concurrency": "workspace:*",
    "@kit/di": "workspace:*",
    "@kit/object-storage": "workspace:*",
    "@kit/result": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@vp/core": "workspace:*",
    "@vp/db": "workspace:*",
    "@vp/dev-identity": "workspace:*",
    "@vp/domain": "workspace:*",
    "@vp/domain-rules": "workspace:*",
    "@vp/env-schema": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/events": "workspace:*",
    "@vp/job-contracts": "workspace:*",
    "@vp/observability": "workspace:*",
    "@vp/permissions": "workspace:*",
    "@vp/validation": "workspace:*",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "onnxruntime-node": "^1.31.1",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@kit/testing": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "@vp/testing-fixtures": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "vp": {
    "layer": 7
  }
}
