{
  "name": "@vp/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./src/result.ts",
      "default": "./dist/result.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./src/jwt.ts",
      "default": "./dist/jwt.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./src/env.ts",
      "default": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/result": "workspace:*",
    "vitest": "^3.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vp/tsconfig": "workspace:*",
    "js-yaml": "^5.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "vp": {
    "layer": 2
  }
}
