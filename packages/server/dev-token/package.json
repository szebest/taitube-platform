{
  "name": "@vp/dev-token",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev-token": "node --experimental-strip-types src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 2
  },
  "dependencies": {
    "@vp/logger": "workspace:*"
  }
}
