{
  "name": "@vp/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": "./src/register.js",
    "./loader": "./src/loader.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/env-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "vp": {
    "layer": 2
  }
}
