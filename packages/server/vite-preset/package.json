{
  "name": "@vp/vite-preset",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/client-app-config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client-app-config.d.ts",
      "import": "./src/client-app-config.ts"
    },
    "./vitest": {
      "types": "./dist/client-app-test-config.d.ts",
      "import": "./src/client-app-test-config.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.168.60",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@tanstack/react-start": "^1.168.60",
    "@types/node": "^24.19.1",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 1
  }
}
