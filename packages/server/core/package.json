{
  "name": "@vp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/ports/index.js",
  "types": "./dist/ports/index.d.ts",
  "exports": {
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js",
      "default": "./dist/ports/index.js"
    },
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "import": "./dist/ports/*.js",
      "default": "./dist/ports/*.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js",
      "default": "./dist/repositories/index.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "import": "./dist/repositories/*.js",
      "default": "./dist/repositories/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/domain": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/permissions": "workspace:*",
    "@vp/result": "workspace:*"
  },
  "devDependencies": {
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "vp": {
    "layer": 3
  }
}
