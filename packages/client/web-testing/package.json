{
  "name": "@vp/web-testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./src/server/index.ts"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./src/dom/index.ts"
    },
    "./api-server.setup": "./src/api-server.setup.ts",
    "./jsdom.setup": "./src/jsdom.setup.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run && vitest run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/api-client": "workspace:*",
    "@vp/api-contracts": "workspace:*",
    "@vp/errors": "workspace:*",
    "axe-core": "^4.14.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "msw": "~3.0.2",
    "react": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "jsdom": "^30.1.2",
    "msw": "~3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 5
  }
}
