{
  "name": "@vp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./design-system.css": "./src/design-system.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run && vitest run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/result": "workspace:*",
    "cookie-es": "^3.1.1",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.168.60",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/react-start": "^1.168.60",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "@vp/web-testing": "workspace:*",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 2
  }
}
