{
  "name": "@vp/web-telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./off.setup": "./src/off.setup.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run && vitest run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-fetch": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vp/api-contracts": "workspace:*",
    "@vp/result": "workspace:*",
    "web-vitals": "^6.2.3"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "@vp/web-testing": "workspace:*",
    "jsdom": "^30.1.2",
    "msw": "~3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 4
  }
}
