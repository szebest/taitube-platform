{
  "name": "@vp/forms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run && vitest run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@vp/errors": "workspace:*",
    "@vp/result": "workspace:*",
    "file-selector": "^5.0.1",
    "react-bootstrap": "^2.10.10",
    "react-dropzone": "^20.1.2"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "@vp/validation": "workspace:*",
    "@vp/web-testing": "workspace:*",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 4
  }
}
