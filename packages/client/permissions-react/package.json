  },
  "dependencies": {
    "@vp/permissions": "workspace:*",
    "@vp/result": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "vp": {
    "layer": 3
  }
