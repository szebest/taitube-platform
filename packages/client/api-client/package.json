{
  "name": "@vp/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/api-contracts": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vp/domain-rules": "workspace:*",
    "@vp/result": "workspace:*",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "@vp/validation": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 4
  }
}
