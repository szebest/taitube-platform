{
  "name": "@vp/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open --no-version-updates",
    "build:storybook": "storybook build --output-dir storybook-static",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vp test run --config vitest.jsdom.config.ts",
    "test:visual": "playwright test -c visual/playwright.config.ts",
    "test:stories": "vp test run --config .storybook/vitest.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "~10.6.2",
    "@storybook/addon-vitest": "~10.6.2",
    "@storybook/react-vite": "~10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "catalog:",
    "@vp/api-client": "workspace:*",
    "@vp/api-contracts": "workspace:*",
    "@vp/components": "workspace:*",
    "@vp/design-tokens": "workspace:*",
    "@vp/intl": "workspace:*",
    "@vp/intl-react": "workspace:*",
    "@vp/messages": "workspace:*",
    "@vp/queries": "workspace:*",
    "@vp/result": "workspace:*",
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "@vp/ui": "workspace:*",
    "@vp/vite-preset": "workspace:*",
    "@vp/web-testing": "workspace:*",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "~10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "vp": {
    "layer": 7
  }
}
