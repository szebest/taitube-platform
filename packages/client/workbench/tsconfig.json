{
  "extends": "@vp/tsconfig/client.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": { "@storybook/react-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"] }
  },
  "include": [
    "src/**/*",
    ".storybook/**/*",
    "../*/src/**/*.stories.tsx",
    "../../../apps/client/*/src/**/*.stories.tsx"
  ],
  "exclude": ["src/**/__tests__/**"]
}
