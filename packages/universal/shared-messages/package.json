{
  "name": "@vp/shared-messages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pl": {
      "types": "./dist/pl/index.d.ts",
      "import": "./dist/pl/index.js",
      "default": "./dist/pl/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "import": "./dist/locales.js",
      "default": "./dist/locales.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vp test run && vp test run --config vitest.jsdom.config.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@kit/i18n": "workspace:*",
    "@kit/intl": "workspace:*",
    "@kit/result": "workspace:*",
    "@vp/errors": "workspace:*"
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@kit/tsconfig": "workspace:*",
    "jsdom": "^30.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "vp": {
    "layer": 6
  }
}
