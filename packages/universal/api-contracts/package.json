{
  "name": "@vp/api-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && openapi-typescript openapi.yaml --output dist/openapi.d.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vp/domain": "workspace:*",
    "@vp/errors": "workspace:*",
    "@vp/pagination": "workspace:*",
    "@vp/validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vp/testing": "workspace:*",
    "@vp/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "vp": {
    "layer": 3
  }
}
