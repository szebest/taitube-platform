{
  "name": "video-pipeline",
  "version": "0.0.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*/*' --filter=@vp/dev-token",
    "build": "pnpm boundaries && turbo run build",
    "test": "vp test run",
    "test:unit": "vp test run --project '!architecture*'",
    "test:coverage": "vp test run --project '!architecture*' --coverage",
    "test:architecture": "vp test run --project 'architecture*' --no-isolate",
    "test:integration": "turbo run test:integration && vp test run --config tests/integration/vitest.config.ts",
    "test:bun": "bun test --timeout 30000 --path-ignore-patterns='**/__tests__/integration/**' apps/server/api apps/server/worker packages/universal packages/server",
    "lint": "vp lint --deny-warnings",
    "react-compiler:report": "tsx scripts/react-compiler-report.ts",
    "knip": "knip",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "pnpm boundaries && turbo run typecheck typecheck:repo",
    "typecheck:repo": "tsc -p tsconfig.repo.json",
    "clean": "turbo run clean && rimraf node_modules",
    "gen-video": "tsx --conditions=source packages/server/gen-video/src/main.ts",
    "dev-token": "tsx --conditions=source packages/server/dev-token/src/main.ts",
    "lighthouse": "tsx packages/server/lighthouse/src/main.ts",
    "upload-client": "tsx --conditions=source packages/server/upload-client/src/main.ts",
    "compose-autoscaler": "tsx --conditions=source packages/server/compose-autoscaler/src/main.ts",
    "stack": "tsx --conditions=source packages/server/stack/src/main.ts",
    "demo": "turbo run build --filter=@vp/demo^... --output-logs=errors-only && tsx --conditions=source packages/server/demo/src/main.ts",
    "envctl": "tsx --conditions=source packages/server/deploy/src/main.ts",
    "perf:clicks": "tsx scripts/perf-clicks.ts",
    "fairness": "tsx scripts/fairness-simulation.ts",
    "models:fetch": "tsx scripts/models-fetch.ts",
    "e2e": "tsx tests/e2e/run-e2e.ts",
    "e2e:web-stack": "tsx tests/e2e/web-stack.ts",
    "test:e2e": "vp test run --config tests/vitest.config.ts",
    "test:browser": "tsx tests/browser/playback.ts",
    "gen:speech-fixture": "tsx scripts/gen-speech-fixture.ts",
    "measure:captions": "tsx scripts/measure-captions.ts",
    "test:live": "tsx tests/live/live-smoke.ts",
    "gen:platform-icons": "tsx scripts/gen-platform-icons.ts",
    "gen:tokens": "turbo run build --filter=@vp/design-tokens --output-logs=errors-only && tsx scripts/gen-tokens.ts",
    "gen:env-docs": "turbo run build --filter=@vp/env-schema^... --output-logs=errors-only && tsx scripts/gen-env-docs.ts",
    "gen:theme": "turbo run build --filter=@vp/design-tokens --output-logs=errors-only && tsx scripts/gen-theme.ts",
    "gen:token-set": "turbo run build --filter=@vp/design-tokens --output-logs=errors-only && tsx scripts/gen-token-set.ts",
    "gen:component": "tsx scripts/gen-component.ts",
    "gen:contracts": "turbo run build --filter=@vp/api^... --output-logs=errors-only && tsx apps/server/api/src/gen-contracts.ts && turbo run build --filter=@vp/api-contracts --output-logs=errors-only",
    "db:migrate": "tsx --env-file-if-exists=.env apps/server/api/src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env apps/server/api/src/seed.ts",
    "db:check": "pnpm --filter @vp/db check",
    "sync:tickets": "python scripts/sync-tickets-to-github.py",
    "prepare": "[ ! -f scripts/install-git-hooks.ts ] || ! command -v tsx >/dev/null || tsx scripts/install-git-hooks.ts",
    "ci:timings": "tsx scripts/ci-timings.ts",
    "ci:health": "tsx scripts/ci-health.ts",
    "preflight": "tsx scripts/preflight.ts",
    "quarantine": "tsx scripts/quarantine.ts",
    "flake-hunt": "tsx scripts/flake-hunt.ts",
    "timings:update": "tsx scripts/timings-update.ts",
    "boundaries": "tsx scripts/check-boundaries.ts && tsx scripts/sync-claude-symlinks.ts --check",
    "sync:claude": "tsx scripts/sync-claude-symlinks.ts",
    "strip:tw-prefix": "tsx scripts/strip-tw-prefix.ts"
  },
  "devDependencies": {
    "@lezer/common": "^1.5.3",
    "@lezer/lr": "^1.4.11",
    "@playwright/test": "^1.64.0",
    "@prometheus-io/lezer-promql": "^0.313.4",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "catalog:",
    "fastify": "^5.12.5",
    "github-slugger": "^2.0.0",
    "js-yaml": "^5.4.3",
    "knip": "^6.41.0",
    "markdown-it": "^15.0.2",
    "playwright-core": "^1.64.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
