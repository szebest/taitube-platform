{
  "name": "video-pipeline",
  "version": "0.0.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test -- --pool=threads",
    "test:integration": "turbo run test:integration",
    "test:bun": "bun test --parallel=4 apps/worker packages tools",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "gen-video": "bun tools/gen-video/src/index.ts",
    "dev-token": "bun tools/dev-token/src/index.ts",
    "upload-client": "bun tools/upload-client/src/cli.ts",
    "compose-autoscaler": "bun tools/compose-autoscaler/src/cli.ts",
    "fairness": "bun scripts/fairness-simulation.ts",
    "e2e": "bun scripts/run-e2e.ts",
    "test:e2e": "vitest run --config tests/vitest.config.ts",
    "db:migrate": "pnpm --filter @vp/db migrate",
    "db:seed": "pnpm --filter @vp/db seed",
    "db:check": "pnpm --filter @vp/db check",
    "sync:tickets": "python scripts/sync-tickets-to-github.py",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^24.0.0",
    "lefthook": "^1.10.10",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
