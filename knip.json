{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["ffmpeg", "ffprobe", "kustomize"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/e2e/e2e-runner.ts", "tests/architecture/typescript.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts!",
        "src/instrument.ts!",
        "src/migrate.ts!",
        "src/seed.ts!",
        "src/**/type-fixtures/*.ts"
      ],
      "project": ["src/**/*.ts!", "!src/**/__tests__/**!", "!src/**/*.test.ts!"]
    },
    "apps/worker": {
      "entry": ["src/main.ts!", "src/instrument.ts!"],
      "project": [
        "src/**/*.ts!",
        "!src/**/__tests__/**!",
        "!src/**/__mocks__/**!",
        "!src/**/*.test.ts!"
      ]
    },
    "apps/web": {
      "entry": ["src/index.tsx!"],
      "project": [
        "src/**/*.{ts,tsx,scss,sass}!",
        "!src/**/__tests__/**!",
        "!src/**/*.test.{ts,tsx}!"
      ]
    },
    "packages/server/testing": {
      "includeEntryExports": false,
      "project": ["src/**/*.ts"]
    },
    "packages/server/dev-token": {
      "entry": ["src/main.ts!"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/server/gen-video": {
      "entry": ["src/main.ts!"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/intl": {
      "entry": ["src/**/type-fixtures/*.ts"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/messages": {
      "entry": ["src/**/type-fixtures/*.ts"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/client/intl-react": {
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/errors": {
      "entry": ["src/**/type-fixtures/*.ts"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/result": {
      "entry": ["src/**/type-fixtures/*.ts"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/*/*": {
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/tsconfig": {
      "entry": [],
      "project": []
    }
  }
}
