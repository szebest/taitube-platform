{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "kustomize",
    "say"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "tests/e2e/e2e-runner.ts",
        "tests/e2e/web-stack.ts",
        "tests/architecture/typescript.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "apps/server/api": {
      "entry": [
        "src/main.ts!",
        "src/instrument.ts!",
        "src/migrate.ts!",
        "src/seed.ts!",
        "src/gen-contracts.ts",
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "!src/**/__tests__/**!",
        "!src/**/*.test.ts!",
        "!src/composition/openapi-document.ts!"
      ]
    },
    "apps/server/worker": {
      "entry": [
        "src/main.ts!",
        "src/instrument.ts!"
      ],
      "project": [
        "src/**/*.ts!",
        "!src/**/__tests__/**!",
        "!src/**/__mocks__/**!",
        "!src/**/*.test.ts!"
      ]
    },
    "apps/client/web": {
      "includeEntryExports": false,
      "entry": [
        "src/router.tsx!",
        "src/routes/**/*.tsx!",
        "src/components/*/*/index.ts!",
        "src/features/url-modal/registry.ts!",
        "src/sw.ts!",
        "src/features/pwa/manifest.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx,scss,sass}!",
        "!src/**/__tests__/**!",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/*.stories.tsx!"
      ]
    },
    "apps/client/studio": {
      "includeEntryExports": false,
      "entry": [
        "src/router.tsx!",
        "src/routes/**/*.tsx!",
        "src/components/*/*/index.ts!",
        "src/features/content/components/library-video-row.tsx!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/__tests__/**!",
        "!src/**/*.test.{ts,tsx}!",
        "!src/**/*.stories.tsx!"
      ]
    },
    "packages/server/testing": {
      "includeEntryExports": false,
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/client/components": {
      "includeEntryExports": false,
      "project": [
        "**/*.{ts,tsx}!",
        "!**/*.stories.tsx!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/client/ui": {
      "includeEntryExports": false,
      "project": [
        "**/*.{ts,tsx,css}!",
        "!**/*.stories.tsx!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/client/workbench": {
      "includeEntryExports": false,
      "project": [
        "{src,.storybook}/**/*.{ts,tsx,css}",
        "!src/**/__tests__/**"
      ]
    },
    "packages/client/web-testing": {
      "includeEntryExports": false,
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/__tests__/**!"
      ]
    },
    "packages/server/vite-preset": {
      "includeEntryExports": false,
      "project": [
        "src/**/*.{ts,css}!",
        "!src/**/__tests__/**!"
      ]
    },
    "packages/server/dev-token": {
      "entry": [
        "src/main.ts!"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/server/gen-video": {
      "entry": [
        "src/main.ts!"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/design-tokens": {
      "includeEntryExports": false,
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/intl": {
      "entry": [
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/messages": {
      "entry": [
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/client/intl-react": {
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/client/queries": {
      "entry": [
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/errors": {
      "entry": [
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/result": {
      "entry": [
        "src/**/type-fixtures/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/*/*": {
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    },
    "packages/universal/tsconfig": {
      "entry": [],
      "project": []
    }
  }
}
