{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!", "tests/e2e/e2e-runner.ts", "tests/load/*.js"],
      "project": ["scripts/**/*.ts!", "tests/**/*.{ts,js}"]
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/migrate.ts!", "src/seed.ts!"],
      "project": ["src/**/*.ts!", "!src/**/__tests__/**!", "!src/**/*.test.ts!"]
    },
    "apps/worker": {
      "entry": ["src/main.ts!"],
      "project": [
        "src/**/*.ts!",
        "!src/**/__tests__/**!",
        "!src/**/__mocks__/**!",
        "!src/**/*.test.ts!"
      ]
    },
    "apps/web": {
      "entry": ["src/index.tsx!", "craco.config.js"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/__tests__/**!", "!src/**/*.test.{ts,tsx}!"]
    },
    "packages/*/*": {
      "entry": ["src/main.ts!", "src/bin/*.ts!"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    }
  }
}
