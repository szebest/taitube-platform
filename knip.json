{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "includeEntryExports": true,
  "ignoreBinaries": ["ffmpeg", "ffprobe", "kubectl", "kustomize"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!", "tests/e2e/e2e-runner.ts"],
      "project": ["scripts/**/*.ts!", "tests/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts!", "src/migrate.ts!", "src/seed.ts!", "src/**/type-fixtures/*.ts"],
      "project": ["src/**/*.ts!", "!src/**/__tests__/**!", "!src/**/*.test.ts!"]
    },
    "apps/worker": {
      "entry": ["src/main.ts!"],
      "project": [
        "src/**/*.ts!",
        "!src/**/__tests__/**!",
        "!src/**/__mocks__/**!",
        "!src/**/*.test.ts!"
      ]
    },
    "apps/web": {
      "entry": ["src/index.tsx!"],
      "ignore": ["craco.config.js"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/__tests__/**!", "!src/**/*.test.{ts,tsx}!"]
    },
    "packages/server/testing": {
      "project": ["src/**/*.ts"]
    },
    "packages/*/*": {
      "entry": ["src/main.ts!", "src/**/type-fixtures/*.ts"],
      "project": [
        "**/*.{ts,tsx,mts,mjs,js}!",
        "!**/__tests__/**!",
        "!**/*.test.{ts,tsx}!",
        "!dist/**"
      ]
    }
  }
}
